# Create a Clerk application at https://dashboard.clerk.com, then add its keys here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# These routes are provided by app/sign-in and app/sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Server-only: used exclusively by the verified Clerk webhook to sync profiles.
SUPABASE_SECRET_KEY=sb_secret_your_supabase_secret_key
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_clerk_webhook_secret

# Production canonical URL. This is used in WhatsApp captain-invite links.
NEXT_PUBLIC_APP_URL=https://suvsolution.com
WHATSAPP_APP_BASE_URL=https://suvsolution.com

# Meta WhatsApp Cloud API. Store these only in your deployment's encrypted
# environment-variable settings; never expose them with a NEXT_PUBLIC_ prefix.
WHATSAPP_VERIFY_TOKEN=replace_with_a_long_random_value
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_whatsapp_business_account_id
WHATSAPP_INVITE_TEMPLATE_NAME=your_approved_template_name
WHATSAPP_INVITE_TEMPLATE_LANGUAGE=en_US
WHATSAPP_API_VERSION=v25.0

# Optional: captain invite links expire after 30 days by default.
TEAM_CAPTAIN_INVITE_TTL_DAYS=30
